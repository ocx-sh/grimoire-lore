block(SCOPE_FOR POLICIES)
cmake_policy(VERSION 3.19)
function(f_in_block)
  cmake_policy(GET CMP0124 p0124)
  cmake_policy(GET CMP0140 p0140)
  message(STATUS "f_in_block: CMP0124=${p0124} CMP0140=${p0140}")
endfunction()
set(SET_INSIDE_BLOCK "visible")
endblock()
function(f_after_block)
  cmake_policy(GET CMP0124 p0124)
  cmake_policy(GET CMP0140 p0140)
  message(STATUS "f_after_block: CMP0124=${p0124} CMP0140=${p0140}")
endfunction()
